                      </div>
                      <div>
                        <p className="text-xs font-medium text-zinc-500 dark:text-zinc-400">Credit Days</p>
                        <p className="mt-1 text-lg font-semibold text-zinc-900 dark:text-zinc-100">
                          {client.max_credit_days ? `${client.max_credit_days} days` : '—'}
