                      </a>
                    )}
                    {client.email && (
                      <div className="flex items-center gap-3 text-sm text-zinc-700 dark:text-zinc-300">
                        <div className="flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-100 dark:bg-zinc-800">
